{
  "name": "brain-coins-backend",
  "version": "1.0.0",
  "description": "Brain Coins Admin Panel - Backend API (Node.js + Express)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-specifier-resolution=node src/server.js",
    "start:worker": "node --experimental-specifier-resolution=node src/queue/learningPackQueue.js",
    "dev": "nodemon --experimental-specifier-resolution=node src/server.js",
    "dev:worker": "nodemon --watch src/queue --exec \"node --experimental-specifier-resolution=node src/queue/learningPackQueue.js\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "brain-coins",
    "api",
    "backend",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@supabase/supabase-js": "^2.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.4",
    "pdf2json": "^4.0.0",
    "pdf2pic": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
